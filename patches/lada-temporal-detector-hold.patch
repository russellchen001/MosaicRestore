diff --git a/lada/restorationpipeline/temporal_hold.py b/lada/restorationpipeline/temporal_hold.py
new file mode 100644
--- /dev/null
+++ b/lada/restorationpipeline/temporal_hold.py
@@ -0,0 +1,18 @@
+# SPDX-FileCopyrightText: MosaicRestore Contributors
+# SPDX-License-Identifier: AGPL-3.0
+
+class TemporalDetectorHold:
+    def __init__(self, frame_limit: int = 2):
+        if frame_limit < 0:
+            raise ValueError("frame_limit must not be negative")
+        self.frame_limit = frame_limit
+        self.frames_since_detection = 0
+
+    def on_detection(self):
+        self.frames_since_detection = 0
+
+    def on_miss(self) -> bool:
+        if self.frames_since_detection >= self.frame_limit:
+            return False
+        self.frames_since_detection += 1
+        return True
